{% extends "base.html" %}

{% block title %}Review Submission: {{ submission.assignment.title }}{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h1 class="display-6 text-primary mb-2">Submission Review</h1>
            <h2 class="h4 text-muted border-bottom pb-2">
                Assignment: <strong>{{ submission.assignment.title }}</strong>
            </h2>
        </div>
    </div>
    
    <!-- Submission Metadata and Content -->
    <div class="row mt-4">
        
        <!-- Submission Details (Left Column) -->
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        Student: <span class="text-info">{{ submission.student.username }} ({{ submission.student.student_id }})</span>
                        <span class="badge bg-secondary ms-3">{{ submission.status }}</span>
                    </h5>
                    <small class="text-muted">Submitted on: {{ submission.submission_date.strftime('%Y-%m-%d %H:%M') }}</small>
                </div>
                <div class="card-body">
                    <h6 class="card-title">Submitted Content:</h6>
                    <pre class="border rounded p-3 bg-dark text-white overflow-auto" style="max-height: 400px; white-space: pre-wrap;">{{ submission.content | default('No content provided.', true) }}</pre>
                </div>
            </div>

            <!-- Auto-Grader Output/Feedback -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Auto-Grader Results</h5>
                </div>
                <div class="card-body">
                    {% if submission.auto_grade_comment %}
                        <p class="mb-1"><strong>Auto-Score:</strong> 
                            <span class="h5 text-success">{{ submission.auto_score | default('N/A', true) }}</span>
                            / 100
                        </p>
                        <hr>
                        <h6>Automated Feedback:</h6>
                        <p class="text-wrap small fst-italic border-start border-4 border-secondary ps-3">
                            {{ submission.auto_grade_comment }}
                        </p>
                    {% else %}
                        <div class="alert alert-warning mb-0">No automated grading has been performed yet for this submission.</div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Grading Form (Right Column) -->
        <div class="col-lg-4">
            <div class="card shadow-lg border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Manual Grading & Feedback</h5>
                </div>
                <div class="card-body">
                    {# Form to update score and feedback #}
                    <form method="POST" action="{{ url_for('main.view_submission', submission_id=submission.id) }}">
                        
                        {# Final Score Field #}
                        <div class="mb-4">
                            <label for="score" class="form-label font-weight-bold">Final Score (0-100)</label>
                            <input type="number" class="form-control form-control-lg" id="score" name="score" 
                                   min="0" max="100" required 
                                   value="{{ submission.score | default(submission.auto_score | default(0), true) }}">
                        </div>

                        {# Status Update (Optional but useful for workflow) #}
                        <div class="mb-4">
                            <label for="status" class="form-label font-weight-bold">Update Status</label>
                            <select class="form-select" id="status" name="status" required>
                                <option value="graded" {% if submission.status == 'graded' %}selected{% endif %}>Graded</option>
                                <option value="reviewed" {% if submission.status == 'reviewed' %}selected{% endif %}>Reviewed (Draft)</option>
                                <option value="submitted" {% if submission.status == 'submitted' %}selected{% endif %}>Submitted (Requires Action)</option>
                            </select>
                        </div>
                        
                        {# Feedback Field #}
                        <div class="mb-4">
                            <label for="feedback" class="form-label font-weight-bold">Manual Feedback / Comments</label>
                            <textarea class="form-control" id="feedback" name="feedback" rows="4" 
                                      placeholder="Provide custom feedback for the student.">{{ submission.teacher_feedback | default('', true) }}</textarea>
                        </div>
                        
                        {# Submit Button #}
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-save me-2"></i> Save Grade & Feedback
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Back Button -->
    <div class="mt-5 text-center">
        <a href="{{ url_for('assignments.assignment_detail', assignment_id=submission.assignment_id) }}" class="btn btn-outline-secondary">
            &larr; Back to Submissions List
        </a>
    </div>
</div>
{% endblock %}
