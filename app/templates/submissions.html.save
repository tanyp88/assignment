{% extends "base.html" %}
  {% block title %}Submissions{% endblock %}
  {% block content %}
  <div class="container mt-5">
      <h2>Submissions</h2>
      {% if current_user.role == 'teacher' %}
          <h3>All Submissions</h3>
      {% else %}
          <h3>Your Submissions</h3>
      {% endif %}
      <table class="table table-striped">
          <thead>
              <tr>
                  <th>Student</th>
                  <th>Assignment</th>
                  <th>Class</th>
                  <th>Content</th>
                  <th>Grade</th>
                  <th>Feedback</th>
                  <th>Submitted At</th>
              </tr>
          </thead>
          <tbody>
              {% for submission in submissions %}
                  <tr>
                      <td>{{ submission.student.student_id }}</td>
                      <td>{{ submission.assignment.title }}</td>
                      <td>{{ submission.assignment.course.name }}</td>
                      <td>{{ submission.content }}</td>
                      <td>{{ submission.grade if submission.grade is not none else 'Pending' }}</td>
                      <td>{{ submission.feedback if submission.feedback else 'Pending' }}</td>
                      <td>{{ submission.submitted_at }}</td>
                  </tr>
              {% endfor %}
          </tbody>
      </table>
  </div>
  {% endblock %}