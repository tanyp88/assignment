{% extends "base.html" %}  {# Extend your base layout template #}

{% block title %}
    Attendance for {{ class_name }}
{% endblock %}

{% block content %}
    <div class="container mt-5">

        <div class="d-flex justify-content-between align-items-center">
            <h1>Attendance: {{ class_name }}</h1>
            <a href="{{ url_for('wechat.record_attendance', class_id=cls.id) }}" class="btn btn-primary">
                <i class="fas fa-qrcode"></i> Start QR Attendance
            </a>
        </div>
        
        <hr>

        <h2 class="h5 text-muted">Date: {{ current_date_display }} (Today)</h2>

        {% set present_count = students | selectattr('present') | list | length %}
        {% set total_students = students | length %}
        {% set absent_count = total_students - present_count %}
        
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-center bg-light">
                    <div class="card-body">
                        <h5 class="card-title">Total Enrolled</h5>
                        <p class="card-text h3">{{ total_students }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center text-white bg-success">
                    <div class="card-body">
                        <h5 class="card-title">Present</h5>
                        <p class="card-text h3">{{ present_count }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center text-white bg-danger">
                    <div class="card-body">
                        <h5 class="card-title">Absent</h5>
                        <p class="card-text h3">{{ absent_count }}</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle" id="attendance-table">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Student ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Status (Today)</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for student in students %}
                    <tr>
                        <th scope="row">{{ loop.index }}</th>
                        <td>{{ student.student_id }}</td>
                        <td>{{ student.name }}</td>
                        <td>
                            {% if student.present %}
                                <span class="badge bg-success">Present</span>
                            {% else %}
                                <span class="badge bg-danger">Absent</span>
                            {% endif %}
                        </td>
                        <td>
                            <button 
                                class="btn btn-sm {% if student.present %}btn-outline-danger{% else %}btn-outline-success{% endif %}" 
                                data-student-id="{{ student.id }}" 
                                data-current-status="{{ student.present }}"
                                onclick="toggleAttendance(this)">
                                {% if student.present %}
                                    Mark Absent
                                {% else %}
                                    Mark Present
                                {% endif %}
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
    </div>
{% endblock %}

{% block scripts %}
    {# Requires Moment.js or Flask-Moment if you use the moment() function above #}
    
    <script>
        function toggleAttendance(button) {
            const studentId = button.getAttribute('data-student-id');
            const currentStatus = button.getAttribute('data-current-status') === 'True';
            const action = currentStatus ? 'mark_absent' : 'mark_present';
            
            // 1. Send AJAX request to Flask route to update the status
            fetch('{{ url_for("wechat.attendance_list", class_id=cls.id) }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    // Include CSRF token if you use Flask-WTF/WTForms
                },
                body: JSON.stringify({
                    student_id: studentId,
                    action: action
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // 2. Update the button and status badge on success without refreshing
                    const row = button.closest('tr');
                    const statusCell = row.querySelector('td:nth-child(4)');

                    if (action === 'mark_present') {
                        statusCell.innerHTML = '<span class="badge bg-success">Present</span>';
                        button.textContent = 'Mark Absent';
                        button.classList.remove('btn-outline-success');
                        button.classList.add('btn-outline-danger');
                        button.setAttribute('data-current-status', 'True');
                    } else {
                        statusCell.innerHTML = '<span class="badge bg-danger">Absent</span>';
                        button.textContent = 'Mark Present';
                        button.classList.remove('btn-outline-danger');
                        button.classList.add('btn-outline-success');
                        button.setAttribute('data-current-status', 'False');
                    }
                    // Optional: Reload the page or update the summary stats
                    // window.location.reload(); 
                } else {
                    alert('Error updating attendance: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while connecting to the server.');
            });
        }
    </script>
{% endblock %}