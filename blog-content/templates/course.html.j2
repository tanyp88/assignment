{# blog-content/templates/course.html.j2 #}
{# /app/blog-content/templates/index.html.j2 #}
{% extends "static_base.html.j2" %}

{% block title %}2025 课程首页 - 谭也平{% endblock %}

{% block content %}
<head>
    <meta charset="UTF-8">
    <title>{{ course.name }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .announcement { background: rgba(255,255,255,0.1); border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    </style>
</head>
<body class="bg-dark text-white">
<div class="container py-5">
    <h1>{{ course.name }}</h1>
    <p class="lead">{{ course.instructor }} · {{ course.semester }}</p>
    <a href="/zuoye/blog/" class="btn btn-outline-light mb-4">返回首页</a>

    <h2 class="mt-5">课程公告</h2>
    {% for a in ann %}
    <div class="announcement">
        <h4>{{ a.title }}</h4>
        {% if a.date %}<small class="text-muted">{{ a.date }}</small>{% endif %}
        <div class="mt-3">{{ a.content | safe }}</div>
    </div>
    {% else %}
    <p class="text-muted">暂无公告</p>
    {% endfor %}

    <h2 class="mt-5">所有课件（你放的我都信）</h2>
    <div class="row g-3">
    {% for p in pres %}
        <div class="col-md-4 col-lg-3">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title text-truncate">{{ p.name }}</h6>
                    <a href="/zuoye/blog/static/{{ class_id }}/presentations/{{ p.file }}" 
                       class="btn btn-primary btn-sm mt-auto" 
                       target="_blank" 
                       rel="noopener">
                       Open / Download 打开或下载
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <p class="text-muted">暂无课件</p>
    {% endfor %}
    </div>
</div>
</body>
{% endblock %}