{# blog-content/templates/index.html.j2 #}
{# /app/blog-content/templates/index.html.j2 #}
{% extends "static_base.html.j2" %}

{% block title %}2025 课程首页 - 谭也平{% endblock %}

{% block content %}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SwiftCheck 课程博客</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .course-card { transition: transform 0.3s; }
        .course-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.3)!important; }
        body { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
    </style>
</head>
<body class="text-white">
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold">SwiftCheck 课程博客</h1>
        <p class="lead">谭也平副教授 · 深圳大学 · 2025 秋季学期</p>
        <p>当前时间：{{ now }} CST</p>
    </div>

    <div class="row g-4">
        {% for course in courses %}
        <div class="col-md-6 col-lg-4">
            <!-- 关键修复：相对路径！ -->
            <a href="course/{{ course.id }}.html" class="text-decoration-none">
                <div class="card course-card bg-dark border-0 text-white h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ course.name }}</h5>
                        <p class="card-text flex-grow-1">{{ course.description | default("点击查看课程公告与课件") }}</p>
                        <small class="text-muted">
                            <i class="bi bi-person-fill"></i> {{ course.instructor }}<br>
                            <i class="bi bi-calendar3"></i> {{ course.semester }}
                        </small>
                    </div>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>

    <div class="text-center mt-5">
        <p>Made with <i class="bi bi-heart-fill text-danger"></i> in Shenzhen · @RealBruceTan</p>
    </div>
</div>
</body>
{% endblock %}