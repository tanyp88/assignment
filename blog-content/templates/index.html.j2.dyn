{# /app/blog-content/templates/index.html.j2 #}
{% extends "static_base.html.j2" %}

{% block title %}2025 课程首页 - 谭也平{% endblock %}

{% block content %}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>谭也平教授 · 2025 课程博客</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #1a2a6c, #b21f1f, #fdbb2d); min-height: 100vh; }
        .card { transition: all 0.3s; border: none; }
        .card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.4); }
    </style>
</head>
<body class="text-white">
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold">2025 秋季课程</h1>
        <p class="lead">谭也平副教授 · 深圳大学</p>
        <p>更新时间：{{ now }} CST</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for c in courses %}
        <div class="col">
            <a href="course/{{ c.id }}.html" class="text-decoration-none">
                <div class="card bg-dark text-white h-100">
                    <div class="card-body text-center py-5">
                        <h3 class="card-title">{{ c.title }}</h3>
                        <p class="card-text">{{ c.description }}</p>
                        <small class="text-muted">点击进入 →</small>
                    </div>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>

    <div class="text-center mt-5 text-muted">
        <small>Made with ❤️ by @RealBruceTan · 2025</small>
    </div>
</div>
</body>
{% endblock %}